# Portainer stack-env for ograf-studio (Hetzner hz02, samme Caddy/proxy-
# opsætning som vinklr). Kopiér værdierne ind i Portainer → Stacks → (stack) →
# Environment variables.
#
# Basic auth (bruger tvmv) ligger som bcrypt-hash direkte i docker-compose.yml.
# Selve passwordet skal IKKE ind her.

# Hvilket image-tag der deployes. Default: latest.
# Pin til en release (fx 0.17) eller en commit (fx sha-abc1234) i produktion.
IMAGE_TAG=latest

# Tidszone.
TZ=Europe/Copenhagen

# --- Valgfrit: AI-agent i editoren -----------------------------------------
# Lad alle stå tomme for at slå agenten fra. Provider: anthropic | openai
# (se apps/mcp-server/src/agent/config.ts i upstream for hele listen).
OGRAF_AGENT_PROVIDER=
OGRAF_AGENT_API_KEY=
OGRAF_AGENT_MODEL=
OGRAF_AGENT_CHEAP_MODEL=
OGRAF_AGENT_BASE_URL=
OGRAF_AGENT_EFFORT=
